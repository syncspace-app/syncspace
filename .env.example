# ─────────────────────────────────────────────────────────────────────────────
# SyncSpace environment variables
#
# Copy this file to `.env` in the repo root and fill in real values.
# Never commit `.env`; it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Database (Neon PostgreSQL) ---------------------------------------------
# Each developer must use their own Neon dev branch.
# Never point local development at the production branch.
#
# DATABASE_URL: pooled connection string (used by the running app)
# DIRECT_URL:   direct connection string (used by Prisma migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- Better Auth ------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# --- Web (public values; safe to expose) ------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# --- Backend ----------------------------------------------------------------
# Allowed browser origin for CORS / auth callbacks.
WEB_ORIGIN=http://localhost:3000

# --- Optional email (password reset / verification) -------------------------
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=
